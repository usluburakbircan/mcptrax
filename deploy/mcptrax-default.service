[Unit]
Description=mcptrax default queue worker (alerts)
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Restart=always
RestartSec=5
ExecStart=/usr/bin/docker exec -u www-data -w /var/www/mcptrax/mcptrax.com/backend mcptrax-php \
    php artisan queue:work --queue=default --sleep=3 --tries=3 --max-time=3600 --timeout=60

[Install]
WantedBy=multi-user.target
